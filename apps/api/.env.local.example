# For running the API on the host (npm run dev) against the Docker MongoDB.
# The replica set advertises itself as mongo:27017, which the host cannot resolve,
# so connect directly to the single node.
MONGO_URI=mongodb://app_user:app_pass@localhost:27017/gold?directConnection=true
MONGO_ROOT_URI=mongodb://root:root_pass@localhost:27017/admin?directConnection=true
PUBLIC_BASE_URL=http://localhost:5173
WEB_ORIGIN=http://localhost:5173
DEV_EXPOSE_OTP=true
