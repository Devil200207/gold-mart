# Copy to .env to override. docker compose reads this file as the API's base config.
MONGO_URI=mongodb://app_user:app_pass@mongo:27017/gold?replicaSet=rs0
# Root credentials are used only by scripts/setup-db-roles.ts (roles, validators, indexes).
MONGO_ROOT_URI=mongodb://root:root_pass@mongo:27017/admin?replicaSet=rs0
JWT_SECRET=change-me
CURRENCY=AED
MOCK_BASE_PRICE_MINOR=30000        # price per gram in minor units
BUY_SPREAD_BPS=150
SELL_SPREAD_BPS=150
FLAT_FEE_MINOR=0
TAX_RATE_BPS=0
MIN_BUY_MINOR=100
UNVERIFIED_BUY_LIMIT_MINOR=500000  # per-order buy limit until KYC is VERIFIED
QUOTE_TTL_SECONDS=180
DELIVERY_MIN_MG=10000
DELIVERY_CHARGE_PAYMENT_TIMEOUT_MIN=30
PHYSICAL_STOCK_MG=5000000
MOCK_GATEWAY_SECRET=change-me
# Browser-facing origin of the web app (nginx proxies /api and /mock-gateway to the API).
PUBLIC_BASE_URL=http://localhost:8080
WEB_ORIGIN=http://localhost:8080
# Local demo only: return login OTPs in the API response and expose admin TOTP codes.
DEV_EXPOSE_OTP=true
ANCHOR_ENABLED=false
ANCHOR_RPC_URL=
ANCHOR_PRIVATE_KEY=
